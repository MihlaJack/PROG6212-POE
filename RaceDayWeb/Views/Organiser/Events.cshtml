@model List<RaceDayWeb.Models.EventDto>
@{
    ViewData["Title"] = "My Events";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Events</h2>
        <a href="@Url.Action("CreateEvent")" class="btn btn-primary">Create New Event</a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Type</th>
                        <th>Distance</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var eventItem in Model)
                    {
                        <tr>
                            <td>@eventItem.Name</td>
                            <td>@eventItem.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@eventItem.Location</td>
                            <td>@eventItem.EventType</td>
                            <td>@eventItem.Distance km</td>
                            <td>
                                <a href="@Url.Action("EditEvent", new { id = eventItem.EventId })" class="btn btn-sm btn-primary">Edit</a>
                                <a href="@Url.Action("DeleteEvent", new { id = eventItem.EventId })" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?')">Delete</a>
                                <a href="@Url.Action("Categories", new { eventId = eventItem.EventId })" class="btn btn-sm btn-secondary">Categories</a>
                                <a href="@Url.Action("Enrolments", new { eventId = eventItem.EventId })" class="btn btn-sm btn-info">Enrolments</a>
                                <a href="@Url.Action("Results", new { eventId = eventItem.EventId })" class="btn btn-sm btn-success">Results</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <p>No events found. <a href="@Url.Action("CreateEvent")">Create your first event</a></p>
        </div>
    }
</div>

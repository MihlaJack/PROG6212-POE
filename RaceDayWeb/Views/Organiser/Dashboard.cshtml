@model List<RaceDayWeb.Models.EventDto>
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">
    <h2 class="mb-4">Organiser Dashboard</h2>
    
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="display-4">@ViewBag.TotalEvents</h3>
                    <p class="text-muted">Total Events</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="display-4">@ViewBag.UpcomingEvents</h3>
                    <p class="text-muted">Upcoming Events</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <a href="@Url.Action("CreateEvent")" class="btn btn-primary btn-lg">Create Event</a>
                </div>
            </div>
        </div>
    </div>

    <h3 class="mb-3">My Events</h3>
    
    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var eventItem in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card">
                        @if (!string.IsNullOrEmpty(eventItem.BannerImageUrl))
                        {
                            <img src="@eventItem.BannerImageUrl" class="card-img-top" alt="@eventItem.Name" style="height: 200px; object-fit: cover;">
                        }
                        <div class="card-body">
                            <h5 class="card-title">@eventItem.Name</h5>
                            <p class="card-text"><small class="text-muted">@eventItem.EventDate.ToString("dd MMM yyyy")</small></p>
                            <p class="card-text">@eventItem.Location</p>
                            <p class="card-text"><strong>@eventItem.EventType</strong> - @eventItem.Distance km</p>
                            <div class="mt-2">
                                <a href="@Url.Action("EditEvent", new { id = eventItem.EventId })" class="btn btn-sm btn-outline-primary">Edit</a>
                                <a href="@Url.Action("Categories", new { eventId = eventItem.EventId })" class="btn btn-sm btn-outline-secondary">Categories</a>
                                <a href="@Url.Action("Enrolments", new { eventId = eventItem.EventId })" class="btn btn-sm btn-outline-info">Enrolments</a>
                                <a href="@Url.Action("Results", new { eventId = eventItem.EventId })" class="btn btn-sm btn-outline-success">Results</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <p>You haven't created any events yet. <a href="@Url.Action("CreateEvent")">Create your first event</a></p>
        </div>
    }
</div>

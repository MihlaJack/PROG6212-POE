@model RaceDayWeb.Models.EventUpdateRequest
@{
    ViewData["Title"] = "Edit Event";
}

<div class="container mt-4">
    <h2 class="mb-4">Edit Event</h2>
    
    <div class="card">
        <div class="card-body">
            <form asp-action="EditEvent" method="post" enctype="multipart/form-data">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        @Html.ValidationSummary(true)
                    </div>
                }
                
                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Event Name</label>
                    <input asp-for="Name" class="form-control" required />
                </div>
                
                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3" required></textarea>
                </div>
                
                <div class="mb-3">
                    <label asp-for="EventDate" class="form-label">Event Date</label>
                    <input asp-for="EventDate" class="form-control" type="date" required />
                </div>
                
                <div class="mb-3">
                    <label asp-for="Location" class="form-label">Location</label>
                    <input asp-for="Location" class="form-control" required />
                </div>
                
                <div class="mb-3">
                    <label asp-for="Distance" class="form-label">Distance (km)</label>
                    <input asp-for="Distance" class="form-control" type="number" step="0.1" required />
                </div>
                
                <div class="mb-3">
                    <label asp-for="EventType" class="form-label">Event Type</label>
                    <select asp-for="EventType" class="form-select" required>
                        <option value="Run">Run</option>
                        <option value="Walk">Walk</option>
                        <option value="Cycle">Cycle</option>
                    </select>
                </div>
                
                <div class="mb-3">
                    <label class="form-label">Event Banner Image</label>
                    <input type="file" name="bannerImage" class="form-control" accept="image/*" />
                    @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
                    {
                        <div class="mt-2">
                            <img src="@Model.BannerImageUrl" alt="Current banner" style="max-height: 200px;" class="img-thumbnail" />
                        </div>
                    }
                </div>
                
                <input type="hidden" asp-for="BannerImageUrl" />
                
                <button type="submit" class="btn btn-primary">Update Event</button>
                <a href="@Url.Action("Events")" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>

@{
    ViewData["Title"] = "Error";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card text-center">
                <div class="card-body py-5">
                    <i class="bi bi-exclamation-triangle" style="font-size: 4rem; color: var(--primary-color);"></i>
                    <h2 class="mt-3">Oops! Something went wrong</h2>
                    <p class="text-muted">We encountered an error while processing your request.</p>
                    <a href="@Url.Action("Index", "Home")" class="btn btn-primary mt-3">Return to Home</a>
                </div>
            </div>
        </div>
    </div>
</div>

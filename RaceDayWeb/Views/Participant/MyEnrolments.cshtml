@model List<RaceDayWeb.Models.EnrolmentDto>
@{
    ViewData["Title"] = "My Enrolments";
}

<div class="container mt-4">
    <h2 class="mb-4">My Event Enrolments</h2>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var enrolment in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">@enrolment.EventName</h5>
                            <p class="card-text"><small class="text-muted">@enrolment.EventDate.ToString("dd MMM yyyy")</small></p>
                            <p class="card-text"><strong>Category:</strong> @enrolment.CategoryName</p>
                            <p class="card-text"><small>Enrolled on: @enrolment.EnrolledAt.ToString("dd MMM yyyy")</small></p>
                            <div class="mt-2">
                                <span class="status-confirmed">Confirmed</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <p>You haven't enrolled in any events yet. <a href="@Url.Action("Index")">Browse upcoming events</a> and enrol today!</p>
        </div>
    }
</div>

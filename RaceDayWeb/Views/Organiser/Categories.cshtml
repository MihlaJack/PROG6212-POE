@model List<RaceDayWeb.Models.CategoryDto>
@{
    ViewData["Title"] = "Categories";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Event Categories</h2>
        <a href="@Url.Action("CreateCategory", new { eventId = ViewBag.EventId })" class="btn btn-primary">Add Category</a>
        <a href="@Url.Action("Events")" class="btn btn-secondary">Back to Events</a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td>@category.Name</td>
                            <td>@category.Description</td>
                            <td>
                                <small class="text-muted">Category ID: @category.CategoryId</small>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <p>No categories defined for this event yet. <a href="@Url.Action("CreateCategory", new { eventId = ViewBag.EventId })">Add your first category</a></p>
        </div>
    }
</div>
